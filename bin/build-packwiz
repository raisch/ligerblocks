#!/bin/bash

cd /opt/ligerblocks/packwiz        # or wherever ./packwiz is
SRC=/tmp/ligerblocks-src
rm -rf "$SRC" && mkdir -p "$SRC"
unzip -q ../modpacks/Ligerblocks.mrpack -d "$SRC"

packwiz init --name LigerBlocks --mc-version 1.21.1 \
  --modloader neoforge --neoforge-version 21.1.256

# look up every mod by hash
jq '{hashes: [.files[].hashes.sha1], algorithm: "sha1"}' "$SRC/modrinth.index.json" \
 | curl -s -X POST https://api.modrinth.com/v2/version_files \
     -H 'Content-Type: application/json' -H 'User-Agent: ligerblocks-convert' \
     -d @- > "$SRC/lookup.json"

# add each one by project and version ID
jq -r '.[] | "\(.project_id) \(.id)"' "$SRC/lookup.json" | while read p v; do
  packwiz modrinth add --project-id "$p" --version-id "$v" -y
done

# bring over bundled configs and loose files
cp -r "$SRC"/overrides/. . 2>/dev/null
packwiz refresh
